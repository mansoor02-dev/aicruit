# LLM providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LLM models
GEMINI_CHAT_MODEL=gemini-2.5-flash
LLM_PRIMARY_MODEL=openai/gpt-oss-120b:free
LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenRouter referer header
APP_URL=http://localhost:3000

# Per-provider timeout (seconds, single attempt each)
LLM_TIMEOUT_SECONDS=60

# Embeddings (Gemini API)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# Follow-up budget per topic (enforced only when history items carry is_followup)
MAX_FOLLOWUPS_PER_TOPIC=2

# Database
DATABASE_URL=

# CORS
FRONTEND_ORIGINS=
