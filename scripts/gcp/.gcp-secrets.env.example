# scripts/gcp/.gcp-secrets.env.example
# Copy to .gcp-secrets.env (gitignored) and fill in real values.
# Each line becomes a Google Secret Manager secret with the same name.

# --- LLM / AI provider keys ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- AWS Cognito (auth provider; gateway calls cognito-idp via boto3) ---
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_USER_POOL_ID=
COGNITO_REGION=us-east-1

# --- Database ---
# Use the Cloud SQL unix-socket form printed by setup.sh, e.g.:
# postgresql+psycopg2://aicruit:PASSWORD@/aicruit?host=/cloudsql/PROJECT:REGION:aicruit-db
DATABASE_URL=
